# ============================================
# Examora Environment Variables
# ============================================
# Copy this file to .env and fill in values.

# ---------- Server ----------
SERVER_PORT=8080

# ---------- PostgreSQL ----------
DB_URL=jdbc:postgresql://localhost:5432/examora
DB_USERNAME=examora
DB_PASSWORD=

# ---------- Database schema/data initialization ----------
# always = run schema.sql (CREATE TABLE IF NOT EXISTS) at startup (dev default)
# never  = skip initialization entirely (recommended for production)
SQL_INIT_MODE=always

# ---------- Demo data (DEVELOPMENT ONLY) ----------
# Setting SPRING_PROFILES_ACTIVE=demo seeds convenience accounts
# (teacher@examora.local / student@examora.local, password: "password").
# Do NOT enable the demo profile in an environment with real data or users.
# SPRING_PROFILES_ACTIVE=demo

# ---------- JWT (REQUIRED) ----------
# Generate with: openssl rand -base64 48
# Minimum 32 characters. Application will not start without this.
JWT_SECRET=

# Token lifetime in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# ---------- CORS / WebSocket origins ----------
# Comma-separated list of origins allowed to call the API and open
# WebSocket connections (default: local Next.js dev origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------- Initial Admin (optional) ----------
# If both are set, an admin account is provisioned on first startup.
# Password must be at least 12 characters.
EXAMORA_INITIAL_ADMIN_EMAIL=
EXAMORA_INITIAL_ADMIN_PASSWORD=

# ---------- Login rate limiting ----------
# Maximum logins per minute for a single email+IP combination and per IP.
LOGIN_MAX_PER_IP_EMAIL=10
LOGIN_MAX_PER_IP=60
LOGIN_WINDOW_SECONDS=60
# Upper bound on tracked IP buckets (memory safety) and sweep interval (ms).
LOGIN_MAX_BUCKETS=100000
LOGIN_CLEANUP_INTERVAL_MS=60000

# ---------- Trusted reverse proxy ----------
# Set to true ONLY when Examora is reached exclusively through a reverse proxy
# that sanitizes X-Forwarded-For. Default false: header ignored, so a direct
# client cannot spoof its rate-limit identity. Optionally restrict which direct
# peers may supply XFF (comma-separated IPs).
# TRUSTED_PROXY=false
# TRUSTED_PROXY_ADDRESSES=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ---------- AI Analysis (optional) ----------
# Required only for the AI analysis feature
# OPENAI_API_KEY=
